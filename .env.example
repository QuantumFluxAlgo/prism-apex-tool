# Prism Apex Tool
# If set, all endpoints require "Authorization: Bearer <value>"
# except /health and /openapi.json (and /version).
BEARER_TOKEN=

# Optional process settings
DATA_DIR=./data
LOG_LEVEL=info

# Rate limit (per IP per route)
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

# Trust reverse proxy (X-Forwarded-*)
TRUST_PROXY=false

# Rate-limiter memory guard (max unique ip+path buckets to retain)
RATE_LIMIT_MAX_BUCKETS=50000

# Guardrails
MIN_RR=1.5
MAX_RR=5.0
FLAT_BY_UTC=20:59:00
# Account registry (single account for MVP)
ACCOUNT_ID=A1
ACCOUNT_PHASE=eval
# Max contracts allowed per account
APEX_MAX_CONTRACTS=5

# Sizing policy (percent of account max contracts)
SIZE_POLICY=percent-of-max
PCT_OF_MAX_WHEN_NO_BUFFER=0.5
PCT_OF_MAX_WHEN_BUFFER=1.0
HALF_SIZE_UNTIL_BUFFER=true
ANTI_WINDFALL=true
ENFORCE_SIZE_HINTS=false
SIZE_JUMP_MULTIPLIER=2
ENFORCE_SIZE_JUMPS=false

# Consistency tracking (metrics only; no enforcement in V1)
CONSISTENCY_TRACKING_ENABLED=true
CONSISTENCY_DAY_SHARE_LIMIT=0.3
CONSISTENCY_MIN_PROFIT_DAY_USD=50
CONSISTENCY_WINDOW_DAYS=8
CONSISTENCY_MIN_PROFIT_DAYS=5
CONSISTENCY_MIN_DAY_PNL=50
CONSISTENCY_TOPDAY_MAX_SHARE=0.30
CONSISTENCY_ENFORCE=false

# Profit quality floor (present but OFF by default)
MIN_PROFIT_TICKS=
MIN_EXPECTED_PROFIT_USD=

# TradingView Webhook
TRADINGVIEW_WEBHOOK_SECRET=

# Tradovate demo market data
TRADOVATE_DEMO_REST_BASE=https://demo.tradovateapi.com/v1
TRADOVATE_MD_WS_URL=wss://md.tradovateapi.com/v1/websocket
TRADOVATE_APP_ID=
TRADOVATE_APP_VERSION=prism-apex/0.2.0
TRADOVATE_USER=
TRADOVATE_PASSWORD=
TRADOVATE_API_CID=
TRADOVATE_API_SEC=
TRADOVATE_DEVICE_ID=prism-apex-dev-telemetry
FEED_SYMBOLS=ESZ4,NQZ4,MESZ4,MNQZ4
BAR_INTERVALS=1m
RTH_OPEN_UTC=13:30
RTH_CLOSE_UTC=20:59

ENABLE_TELEMETRY=true
TELEMETRY_POLL_MS=5000
BUFFER_CLEAR_THRESHOLD=2500
