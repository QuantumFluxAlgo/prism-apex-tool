{
  "name": "prism-apex-tool",
  "version": "0.1.0",
  "private": true,
  "description": "Prism Apex Tool monorepo",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "pnpm --filter \"./packages/**\" typecheck",
    "test": "pnpm run test:api",
    "test:api": "pnpm -r --filter @prism-apex/api test",
    "build": "pnpm run build:api",
    "scan:dead": "depcheck --ignores=\"@typescript-eslint/*,@eslint/js,@types/react,@types/react-dom,eslint-config-prettier,eslint-plugin-import,eslint-plugin-prettier,eslint-plugin-simple-import-sort,globals,rimraf,ts-node,typescript-eslint\"",
    "build:api": "pnpm -r --filter @prism-apex/api build",
    "test:e2e": "playwright test",
    "typecheck:api": "pnpm -r --filter @prism-apex/api typecheck",
    "ops:postdeploy:gapfill": "tools/codex/postdeploy-gapfill.sh",
    "ops:verify": "tools/codex/verify-stack.sh"
  },
  "engines": {
    "node": ">=20 <21"
  },
  "packageManager": "pnpm@9.0.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/analytics",
    "packages/strategies"
  ],
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@types/node": "^24.6.2",
    "@types/react": "18",
    "@types/react-dom": "18",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "depcheck": "^1.4.3",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-simple-import-sort": "^12.0.0",
    "eslint-plugin-unused-imports": "4.2.0",
    "globals": "^16.4.0",
    "husky": "^9.0.10",
    "jsdom": "27.0.0",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "ts-prune": "latest",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.45.0",
    "vitest": "^3.2.4",
    "vite-tsconfig-paths": "5.1.4"
  },
  "lint-staged": {
    "**/*.{ts,js,json,md,yml,yaml}": "prettier -w",
    "**/*.ts": "eslint --fix"
  }
}
