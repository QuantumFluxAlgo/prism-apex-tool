services:
  reverse-proxy:
    image: nginx:1.27-alpine
    container_name: prism-apex-reverse-proxy
    restart: unless-stopped
    ports:
      - "${REVERSE_PROXY_PORT:-8090}:80"
    volumes:
      - ./nginx.local.conf:/etc/nginx/conf.d/default.conf:ro

  cloudflare-quick:
    image: cloudflare/cloudflared:latest
    container_name: prism-apex-cloudflared-quick
    restart: unless-stopped
    depends_on:
      - reverse-proxy
    environment:
      TUNNEL_UPSTREAM: ${TUNNEL_UPSTREAM:-http://reverse-proxy:80}
    command:
      - tunnel
      - --no-autoupdate
      - --url
      - ${TUNNEL_UPSTREAM:-http://reverse-proxy:80}

  cloudflare-named:
    image: cloudflare/cloudflared:latest
    container_name: prism-apex-cloudflared
    restart: unless-stopped
    depends_on:
      - reverse-proxy
    environment:
      CLOUDFLARE_TUNNEL_TOKEN: ${CLOUDFLARE_TUNNEL_TOKEN:-}
    command:
      - tunnel
      - --no-autoupdate
      - run
      - --token
      - ${CLOUDFLARE_TUNNEL_TOKEN}
