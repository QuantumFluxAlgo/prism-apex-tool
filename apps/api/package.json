{
  "name": "@prism-apex/api",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test:api": "vitest run --config apps/api/vitest.config.ts --reporter=verbose --passWithNoTests",
    "dev": "tsx watch src/index.ts",
    "build": "tsup --config tsup.config.ts",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "start": "node dist/index.cjs",
    "test": "vitest run --reporter=verbose --passWithNoTests",
    "lint": "eslint . --ext .ts",
    "openapi:emit": "tsx src/scripts/openapi.ts > openapi.json",
    "sync:tickets": "tsx src/scripts/syncTickets.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@types/node": "^24.6.2",
    "@vitest/coverage-v8": "^3.2.4",
    "@types/pg": "^8.11.10",
    "eslint": "^9.37.0",
    "globals": "^16.4.0",
    "prettier": "^3.3.3",
    "tsup": "8.5.0",
    "tsx": "4.20.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.45.0",
    "vitest": "^3.2.4",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.1.0",
    "@fastify/cors": "11.1.0",
    "@prism-apex/accounts": "workspace:*",
    "@prism-apex/analytics": "workspace:*",
    "@prism-apex/audit": "workspace:*",
    "@prism-apex/clients-tradovate": "workspace:*",
    "@prism-apex/config": "workspace:*",
    "@prism-apex/consistency": "workspace:*",
    "@prism-apex/indicators": "workspace:*",
    "@prism-apex/metrics": "workspace:*",
    "@prism-apex/rules-apex": "workspace:*",
    "@prism-apex/runtime": "workspace:*",
    "@prism-apex/shared": "workspace:*",
    "@prism-apex/signals": "workspace:*",
    "@prism-apex/strategies": "workspace:*",
    "@prism-apex/strategy-apx-ddb01": "workspace:*",
    "fastify": "5.6.1",
    "fastify-plugin": "5.1.0",
    "pg": "^8.13.1",
    "tsconfig-paths": "latest",
    "yahoo-finance2": "2.13.3",
    "zod": "^3.23.8"
  },
  "type": "module",
  "main": "dist/server.cjs"
}
