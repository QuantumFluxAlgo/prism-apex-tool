{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src/scripts",
    "outDir": "./dist-cjs/scripts",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowJs": false,
    "resolveJsonModule": true,
    "sourceMap": false,
    "declaration": false
  },
  "include": ["./src/scripts/**/*"]
}
