{
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "resolveJsonModule": true,
    "rootDir": ".",
    "skipLibCheck": true,
    "types": [
      "node",
      "vitest/globals"
    ]
  },
  "extends": "../../tsconfig.base.json",
  "include": [
    "src",
    "types/**/*.d.ts",
    "vitest.config.ts"
  ]
}
