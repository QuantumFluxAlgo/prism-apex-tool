{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "paths": {},
    "types": ["vitest/globals"],
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "moduleResolution": "node"
  },
  "include": ["src", "types/**/*.d.ts"],
  "exclude": [
    "src/__tests__/**",
    "src/tests/**",
    "**/*.spec.ts",
    "src/__tests__._archived/**",
    "src/jobs/jobManagerTestHooks.ts"
  ]
}
