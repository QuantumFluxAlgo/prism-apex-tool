{
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": "./src",
    "sourceMap": true,
    "types": [
      "node"
    ]
  },
  "exclude": [
    "**/*.test.ts",
    "**/*.spec.ts",
    "node_modules",
    "dist"
  ],
  "extends": "../../tsconfig.base.json",
  "include": [
    "src/**/*"
  ]
}
