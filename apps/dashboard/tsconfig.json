{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "module": "esnext",
    "target": "es2020",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "rootDir": ".",
    "baseUrl": ".",
    "types": [
      "vite/client",
      "vitest/globals"
    ],
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": [
    "index.html",
    "postcss.config.cjs",
    "src",
    "tailwind.config.cjs",
    "types/**/*.d.ts",
    "vite.config.ts",
    "vitest.config.ts"
  ],
  "exclude": [
    "src/__tests__"
  ]
}
