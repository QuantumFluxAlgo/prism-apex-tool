{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "outDir": "dist",
    "rootDir": ".",
    "types": ["vite/client"],
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": false,
    "module": "ESNext"
  },
  "include": [
    "src",
    "vite.config.ts",
    "tailwind.config.cjs",
    "postcss.config.cjs",
    "vitest.config.ts",
    "index.html"
  ],
  "exclude": ["src/__tests__"]
}
