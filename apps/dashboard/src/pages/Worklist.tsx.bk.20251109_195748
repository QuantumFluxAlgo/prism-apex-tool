import React, { useEffect, useState } from 'react';
import { fetchTickets, type TicketRow } from '../lib/api';
import { fmtR, fmtPrice } from '../utils/number';
import { Tooltip } from '../ui/Tooltip';
import { Tooltip } from "../ui/Tooltip";

/** Types the Tickets page expects to import from Worklist */
export type ActionableRow = TicketRow;

/** Minimal pass-through cells to satisfy Tickets.tsx imports */
export const OperatorSizingCell: React.FC<{ row: TicketRow }> = ({ row }) => {
  const qty = row?.operatorSizing?.qty ?? '—';
  return <span data-cell="OperatorSizingCell">{qty}</span>;
};

export const PnLDataCell: React.FC<{ row: TicketRow }> = ({ row }) => {
  const val = row?.pnlAmount ?? row?.pnl ?? 0;
  return <span data-cell="PnLDataCell">{fmtPrice(val)}</span>;
};

export const PnLRRCell: React.FC<{ row: TicketRow }> = ({ row }) => {
  const rr = row?.pnlRatio ?? row?.rr ?? 0;
  return <span data-cell="PnLRRCell">{fmtR(rr)}</span>;
};

/** Minimal Worklist page — builds cleanly and unblocks the app */
function Worklist() {
  const [rows, setRows] = useState<TicketRow[]>([]);

  useEffect(() => {
    (async () => {
      try {
        const res = await fetchTickets({ limit: 20 });
        const list = (res as any)?.rows ?? (res as any)?.tickets ?? [];
        if (Array.isArray(list)) setRows(list as TicketRow[]);
      } catch {
        // swallow — this page is a minimal unblocker
      }
    })();
  }, []);

  return (
    <div style={{ padding: 16 }}>
      <h2 style={{ margin: 0, marginBottom: 8 }}>Worklist</h2>
      <div style={{ marginBottom: 12, opacity: 0.85 }}>
        <Tooltip text="Temporary minimal Worklist to unblock build">
          <span>Temporary view · rows: {rows.length}</span>
        </Tooltip>
      </div>
      <ul style={{ margin: 0, paddingLeft: 18 }}>
        {rows.slice(0, 10).map((r, i) => (
          <li key={i}>
            {r.symbol ?? '—'} · {(r as any).strategy ?? '—'} · qty={(r as any)?.operatorSizing?.qty ?? '—'}
          </li>
        ))}
        {rows.length === 0 && <li>— no tickets —</li>}
      </ul>
    </div>
  );
}


export { OperatorSizingCell, PnLDataCell, PnLRRCell };

export default Worklist;
