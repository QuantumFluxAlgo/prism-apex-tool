          </div>

          <Card title="Config Impact (What-If)">
            {configImpact.length ? (
              <div className="space-y-2 text-xs text-slate-300">
                {configImpact.map((c) => (
                  <div
                    key={c.label}
                    className="flex items-center justify-between"
                  >
                    <div className="flex items-center gap-2">
                      <Badge tone={c.label === "Actual" ? "strategy" : "neutral"}>
                        {c.label}
                      </Badge>
                      <span className="text-slate-400">
                        {c.trades} trades
                      </span>
                    </div>
                    <span className="font-mono">
                      {c.pnlR.toFixed(2)}R · {c.winRate.toFixed(1)}% · DD {" "}
                      {c.maxDrawdownR.toFixed(2)}R
                    </span>
                  </div>
                ))}
              </div>
            ) : (
              <div className="text-slate-400 text-sm">
                No configuration impact scenario available.
              </div>
            )}
          </Card>
        </div>
      </div>
    </ExecutionShell>
  );
}

export default AnalyticsPage;
