function isWinningTicket(ticket: CanonicalTicket): boolean {
  if (ticket.realisedR == null) return false;
  return ticket.realisedR > 0;
}

function isLosingTicket(ticket: CanonicalTicket): boolean {
  if (ticket.realisedR == null) return false;
  return ticket.realisedR < 0;
}

function isNewsTicket(ticket: CanonicalTicket): boolean {
  return ticket.newsFlag === NewsFlag.NewsSession;
}

function toDailyKey(dateIso: string): string {
  try {
    const d = parseISO(dateIso);
    return format(d, "yyyy-MM-dd");
  } catch {
    return dateIso.slice(0, 10);
  }
}

function bucketAtr(atrMultiple: number | null | undefined): string {
  if (atrMultiple == null || Number.isNaN(atrMultiple)) return "Unknown";
  if (atrMultiple < 0.5) return "< 0.5x ATR";
  if (atrMultiple < 1.0) return "0.5–1.0x ATR";
  if (atrMultiple < 1.5) return "1.0–1.5x ATR";
  if (atrMultiple < 2.0) return "1.5–2.0x ATR";
  return "≥ 2.0x ATR";
}

function computeDrawdownR(series: number[]): number {
  if (!series.length) return 0;
  let peak = 0;
  let trough = 0;
  let maxDD = 0;
  let cum = 0;
  for (const r of series) {
    cum += r;
    if (cum > peak) {
      peak = cum;
      trough = cum;
    }
    if (cum < trough) {
      trough = cum;
      const dd = peak - trough;
      if (dd > maxDD) maxDD = dd;
    }
  }
  return maxDD;
}

function computeAnalytics(
  tickets: AnalyticsTicket[]
): {
  kpis: {
    totalPnLR: number;
    winRate: number;
    maxDrawdownR: number;
    rr: number;
    trades: number;
  };
  dailyPoints: DailyPoint[];
  strategySummaries: StrategySummary[];
  regimeSummaries: RegimeSummary[];
  atrBuckets: AtrBucketSummary[];
  newsSplit: NewsSplitSummary[];
  configImpact: ConfigImpactSummary[];
} {
  const realisedTickets = tickets.filter(
    (t) => t.realisedR != null && !Number.isNaN(t.realisedR)
  );

  const trades = realisedTickets.length;
  const totalPnLR = realisedTickets.reduce(
    (acc, t) => acc + (t.realisedR ?? 0),
    0
  );
  const wins = realisedTickets.filter(isWinningTicket).length;
  const losses = realisedTickets.filter(isLosingTicket).length;

  const winRate = trades ? (wins / trades) * 100 : 0;

  const rr =
    wins && losses
      ? Math.abs(
          realisedTickets
            .filter((t) => t.realisedR != null && t.realisedR !== 0)
            .reduce(
              (acc, t) =>
                t.realisedR! > 0
                  ? acc + t.realisedR!
                  : acc - t.realisedR!,
              0
            ) / trades
        )
      : 0;

  const cumulativeRSeries: number[] = [];
  let cum = 0;
  for (const t of realisedTickets) {
    cum += t.realisedR ?? 0;
    cumulativeRSeries.push(cum);
  }
  const maxDrawdownR = computeDrawdownR(cumulativeRSeries);

  const kpis = {
    totalPnLR,
    winRate,
    maxDrawdownR,
    rr,
    trades,
  };

  const dailyMap: Record<string, DailyPoint> = {};
  for (const t of realisedTickets) {
    const key = toDailyKey(t.openedAtUtc);
    const existing = dailyMap[key] ?? {
      date: key,
      pnlR: 0,
      winRate: 0,
      trades: 0,
    };
    existing.pnlR += t.realisedR ?? 0;
    existing.trades += 1;
    dailyMap[key] = existing;
  }
  const dailyPoints: DailyPoint[] = Object.values(dailyMap).map((p) => {
    const dayTickets = realisedTickets.filter(
      (t) => toDailyKey(t.openedAtUtc) === p.date
    );
    const dayTrades = dayTickets.length;
    const dayWins = dayTickets.filter(isWinningTicket).length;
    const dayWinRate = dayTrades ? (dayWins / dayTrades) * 100 : 0;
    return {
      ...p,
      winRate: dayWinRate,
    };
  });

  const strategyMap: Record<string, StrategySummary> = {};
  for (const t of realisedTickets) {
    const key = t.strategy ?? "UNKNOWN";
    const existing =
      strategyMap[key] ??
      ({
        strategy: key,
        trades: 0,
        pnlR: 0,
        winRate: 0,
        maxDrawdownR: 0,
        avgRR: 0,
        newsTrades: 0,
        newsPnLR: 0,
      } as StrategySummary);
    existing.trades += 1;
    existing.pnlR += t.realisedR ?? 0;
    if (isWinningTicket(t)) existing.winRate += 1;
    if (isNewsTicket(t)) {
      existing.newsTrades += 1;
      existing.newsPnLR += t.realisedR ?? 0;
    }
    strategyMap[key] = existing;
  }
  const strategySummaries: StrategySummary[] = Object.values(strategyMap).map(
    (s) => {
      const rr = s.trades ? s.pnlR / s.trades : 0;
      const wins = s.winRate;
      const winRatePct = s.trades ? (wins / s.trades) * 100 : 0;

      const stratTickets = realisedTickets.filter(
        (t) => (t.strategy ?? "UNKNOWN") === s.strategy
      );
      const stratSeries: number[] = [];
      let cumStrat = 0;
      for (const t of stratTickets) {
        cumStrat += t.realisedR ?? 0;
        stratSeries.push(cumStrat);
      }
      const stratDD = computeDrawdownR(stratSeries);

      return {
        ...s,
        winRate: winRatePct,
        avgRR: rr,
        maxDrawdownR: stratDD,
      };
    }
  );

  const regimeMap: Record<string, RegimeSummary> = {};
  for (const t of realisedTickets) {
    const regime = t.sessionMetrics?.regime ?? "Unknown";
    const existing =
      regimeMap[regime] ??
      ({
        regime,
        trades: 0,
        pnlR: 0,
        winRate: 0,
        avgRR: 0,
      } as RegimeSummary);
    existing.trades += 1;
    existing.pnlR += t.realisedR ?? 0;
    if (isWinningTicket(t)) existing.winRate += 1;
    regimeMap[regime] = existing;
  }
  const regimeSummaries: RegimeSummary[] = Object.values(regimeMap).map(
    (r) => {
      const rr = r.trades ? r.pnlR / r.trades : 0;
      const wins = r.winRate;
      const winRatePct = r.trades ? (wins / r.trades) * 100 : 0;
      return {
        ...r,
        winRate: winRatePct,
        avgRR: rr,
      };
    }
  );

  const atrMap: Record<string, AtrBucketSummary> = {};
  for (const t of realisedTickets) {
    const bucket = bucketAtr(t.sessionMetrics?.atrMultiple ?? null);
    const existing =
      atrMap[bucket] ??
      ({
        bucket,
        trades: 0,
        pnlR: 0,
        winRate: 0,
      } as AtrBucketSummary);
    existing.trades += 1;
    existing.pnlR += t.realisedR ?? 0;
    if (isWinningTicket(t)) existing.winRate += 1;
    atrMap[bucket] = existing;
  }
  const atrBuckets: AtrBucketSummary[] = Object.values(atrMap).map((b) => {
    const wins = b.winRate;
    const winRatePct = b.trades ? (wins / b.trades) * 100 : 0;
    return {
      ...b,
      winRate: winRatePct,
    };
  });

  const newsTickets = realisedTickets.filter(isNewsTicket);
  const nonNewsTickets = realisedTickets.filter((t) => !isNewsTicket(t));

  const newsTrades = newsTickets.length;
  const newsPnLR = newsTickets.reduce(
    (acc, t) => acc + (t.realisedR ?? 0),
    0
  );
  const newsWins = newsTickets.filter(isWinningTicket).length;
  const newsWinRate = newsTrades ? (newsWins / newsTrades) * 100 : 0;

  const nonNewsTrades = nonNewsTickets.length;
  const nonNewsPnLR = nonNewsTickets.reduce(
    (acc, t) => acc + (t.realisedR ?? 0),
    0
  );
  const nonNewsWins = nonNewsTickets.filter(isWinningTicket).length;
  const nonNewsWinRate = nonNewsTrades ? (nonNewsWins / nonNewsTrades) * 100 : 0;

  const newsSplit: NewsSplitSummary[] = [
    {
      segment: "News",
      trades: newsTrades,
      pnlR: newsPnLR,
      winRate: newsWinRate,
    },
    {
      segment: "Non-News",
      trades: nonNewsTrades,
      pnlR: nonNewsPnLR,
      winRate: nonNewsWinRate,
    },
  ];

  const configImpact: ConfigImpactSummary[] = [
    {
      label: "Actual",
      trades,
      pnlR: totalPnLR,
      winRate,
      maxDrawdownR,
    },
    {
      label: "Exclude News Sessions",
      trades: nonNewsTrades,
      pnlR: nonNewsPnLR,
      winRate: nonNewsWinRate,
      maxDrawdownR,
    },
  ];

  return {
    kpis,
    dailyPoints,
    strategySummaries,
    regimeSummaries,
    atrBuckets,
    newsSplit,
    configImpact,
  };
}

function useAnalyticsData(filters: AnalyticsFilters): AnalyticsState {
  const [state, setState] = React.useState<AnalyticsState>({
    loading: true,
    error: null,
    tickets: [],
    sessionMetricsMap: {},
  });

  React.useEffect(() => {
    let cancelled = false;

    async function load() {
      setState((s) => ({ ...s, loading: true, error: null }));
      try {
        const { tickets } = await fetchAnalyticsCanonicalTickets({
          from: filters.from ?? undefined,
          to: filters.to ?? undefined,
          symbol: filters.symbol ?? undefined,
          strategy: filters.strategy ?? undefined,
          regime: filters.regime ?? undefined,
          volatilityBucket: filters.volatilityBucket ?? undefined,
          search: filters.search || undefined,
          newsOnly: filters.newsOnly ?? undefined,
        });

        const symbolSessions = Array.from(
          new Set(
            tickets.map((t) =>
              makeSessionMetricsKey(t.symbol, t.sessionDate)
            )
          )
        );

        const sessionMetricsList = await fetchSessionMetricsBatch({
          symbolSessions,
        });

        const sessionMetricsMap: Record<string, SessionMetricsDto | null> = {};
        for (const sm of sessionMetricsList) {
          const key = makeSessionMetricsKey(sm.symbol, sm.sessionDate);
          sessionMetricsMap[key] = sm;
        }

        const ticketsWithMetrics: AnalyticsTicket[] = tickets.map((t) => {
          const key = makeSessionMetricsKey(t.symbol, t.sessionDate);
          return {
            ...t,
            sessionMetrics: sessionMetricsMap[key] ?? null,
          };
        });

        if (cancelled) return;

        setState({
          loading: false,
          error: null,
          tickets: ticketsWithMetrics,
          sessionMetricsMap,
        });
      } catch (err: any) {
        if (cancelled) return;
        setState((s) => ({
          ...s,
          loading: false,
          error:
            err?.message ??
            "Failed to load analytics tickets or session metrics",
        }));
      }
    }

    load();

    return () => {
      cancelled = true;
    };
  }, [
    filters.from,
    filters.to,
    filters.symbol,
    filters.strategy,
    filters.regime,
    filters.volatilityBucket,
    filters.search,
    filters.newsOnly,
  ]);

  return state;
}

function AnalyticsKpiRow({ kpis }: { kpis: {
  totalPnLR: number;
  winRate: number;
  maxDrawdownR: number;
  rr: number;
  trades: number;
} }) {
  return (
    <div className="grid grid-cols-1 md:grid-cols-5 gap-4">
      <Kpi
        label="Total PnL (R)"
        value={kpis.totalPnLR.toFixed(2)}
        variant={kpis.totalPnLR >= 0 ? "positive" : "negative"}
      />
      <Kpi
        label="Win Rate"
        value={`${kpis.winRate.toFixed(1)}%`}
      />
      <Kpi
        label="Max Drawdown (R)"
        value={kpis.maxDrawdownR.toFixed(2)}
        variant={kpis.maxDrawdownR <= 0 ? "neutral" : "negative"}
      />
      <Kpi
        label="Avg R/R"
        value={kpis.rr.toFixed(2)}
      />
      <Kpi
        label="Trades"
        value={String(kpis.trades)}
      />
    </div>
  );
}

