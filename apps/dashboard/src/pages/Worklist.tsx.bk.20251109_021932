/* =============================================================================
   Compatibility exports for Tickets.tsx (restored after refactors)
   These are minimal pass-through components/types to satisfy imports:
   - OperatorSizingCell
   - PnLDataCell
   - PnLRRCell
   - type ActionableRow
   You can replace these with the richer implementations later.
============================================================================= */

export type ActionableRow = TicketRow;

export const OperatorSizingCell: React.FC<{ row: TicketRow }> = ({ row }) => {
  const qty = row?.operatorSizing?.qty ?? '—';
  return <span data-cell="OperatorSizingCell">{qty}</span>;
};

export const PnLDataCell: React.FC<{ state?: any }> = ({ state }) => {
  // Expecting something like { rr, riskUsd, pnlUsd } – render simply for now
  const rr = state?.rr ?? null;
  const txt = rr == null ? '—' : String(rr);
  return <span data-cell="PnLDataCell">{txt}</span>;
};

export const PnLRRCell: React.FC<{ state?: any }> = ({ state }) => {
  const rr = state?.rr;
  const txt =
    rr == null
      ? '—'
      : (typeof rr === 'number' && Number.isFinite(rr))
        ? `${rr.toFixed(2)} R`
        : String(rr);
  return <span data-cell="PnLRRCell">{txt}</span>;
};
