{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "types": ["vite/client"],
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["web/src", "web/src/**/*.ts", "web/src/**/*.tsx"],
  "exclude": ["**/*.test.*", "**/*.spec.*", "node_modules", "dist"]
}
