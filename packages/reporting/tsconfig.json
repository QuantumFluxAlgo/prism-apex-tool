{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": ".",
    "declaration": true,
    "declarationMap": true,
    "types": ["vitest/globals"],
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "moduleResolution": "node"
  },
  "include": ["src", "types/**/*.d.ts", "vitest.config.ts"],
  "references": [
    {
      "path": "../../tsconfig.paths.json"
    }
  ]
}
