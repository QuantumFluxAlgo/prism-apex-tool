{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "outDir": "dist",
    "rootDir": "../..",
    "declaration": true,
    "declarationMap": true,
    "allowImportingTsExtensions": false,
    "emitDeclarationOnly": false,
    "types": ["node", "vitest/globals"],
