{
  "name": "@prism-apex-tool/rules",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./apex": {
      "types": "./src/apex.ts",
      "default": "./src/apex.ts"
    },
    "./apex.js": "./src/apex.ts",
    "./config": {
      "types": "./src/config.ts",
      "default": "./src/config.ts"
    },
    "./config.js": "./src/config.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest --run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --ext .ts",
    "format": "prettier -w .",
    "format:check": "prettier -c ."
  },
  "dependencies": {},
  "devDependencies": {
    "eslint": "^9.10.0",
    "@eslint/js": "^9.10.0",
    "typescript-eslint": "^8.7.0",
    "prettier": "^3.3.3"
  }
}
